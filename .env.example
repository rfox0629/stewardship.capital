# --- Supabase, Spark identity and data -------------------------------------
# Project: Stewardship.Capital / Spark
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server side only. Used for the two operations that must bypass row level
# security on purpose: redeeming an invitation for someone who is not yet a
# member, and provisioning membership on acceptance. Never expose to the
# browser and never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# --- Legacy stewardship platform -------------------------------------------
# Read by the preserved dashboard and assessment surfaces.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Spark session signing --------------------------------------------------
# Required in production, minimum 32 characters. Production refuses to sign
# sessions without it rather than falling back to a development secret.
# Superseded for identity once Supabase Auth lands, still used for any
# remaining signed server state.
SPARK_SESSION_SECRET=

# --- Verification email delivery -------------------------------------------
# Required in production. Without it, non production logs the code server side
# and production treats an unconfigured mailer as an error.
RESEND_API_KEY=
SPARK_MAIL_FROM=
