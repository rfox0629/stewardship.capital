# --- Supabase, Spark identity and data -------------------------------------
# Project: Stewardship.Capital / Spark
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server side only. Used for the operations that must bypass row level
# security on purpose: finding an invitation by token hash before anyone is
# signed in, and creating the account a live invitation authorises. Never
# expose to the browser and never prefix with NEXT_PUBLIC.
SUPABASE_SERVICE_ROLE_KEY=

# Only for the migration and verification scripts. The running application
# never reads it. Supabase dashboard, Project Settings, Database, Connection
# string, URI. Session pooler on 5432 or the direct connection, not 6543.
SPARK_DATABASE_URL=

# --- Legacy stewardship platform -------------------------------------------
# Read by the preserved dashboard and assessment surfaces.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# There is no SPARK_SESSION_SECRET. Spark signs nothing of its own: identity
# is Supabase Auth, and authorization is read from the database per request.

# --- Operating scripts only ---------------------------------------------
# Personal access token from supabase.com/dashboard/account/tokens. Used by
# npm run auth:configure to set the production Auth configuration. Can change
# project settings, so treat it like a password.
SUPABASE_ACCESS_TOKEN=

# Custom SMTP for Supabase Auth email. Filled in before real invitations;
# npm run auth:configure applies them and raises the email rate limit.
SPARK_SMTP_HOST=
SPARK_SMTP_PORT=587
SPARK_SMTP_USER=
SPARK_SMTP_PASS=
SPARK_SMTP_SENDER=
SPARK_SMTP_SENDER_NAME=Spark
